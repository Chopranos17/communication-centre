# Copy to `.env` and fill in real values locally. Never commit `.env`.

DATABASE_URL="file:./dev.db"

# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxx
# Optional — verified sender addresses for API (defaults to onboarding@resend.dev for both)
# RESEND_FROM_NOREPLY=onboarding@resend.dev
# RESEND_FROM_CONTACT=onboarding@resend.dev

# Twilio — https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# API server port (optional; default 3001)
# PORT=3001

# Optional — labels shown in SMS / WhatsApp compose modals (Vite frontend)
# VITE_SMS_SENDER_LABEL=Twilio SMS
# VITE_WHATSAPP_BUSINESS_NAME=Darwinbox WhatsApp Business

# Optional — real addresses for 2–3 demo candidates (seed script uses safe fallbacks if unset)
# SEED_DEMO_EMAIL_1=
# SEED_DEMO_EMAIL_2=
# SEED_DEMO_EMAIL_3=
