generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

// SQLite: store PRD §5 / tasks.md enum-like values as strings (see seed + app validation).

model Candidate {
  id                String @id @default(cuid())
  name              String
  email             String
  phone             String?
  whatsapp_number   String?
  /// applied | shortlisting | screening | assessment | interview | pre_offer | offer | hired | rejected
  current_stage     String
  recruiter_id      String?
  hiring_lead_id    String?
  hiring_manager_id String?
  /// job_portal | referral | external_recruiter | IJP | CRM
  source            String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  jobs           CandidateJob[]
  communications Communication[]
  meetings       Meeting[]

  // Add to Candidate model fields:
  sms_consent_status  String    @default("pending") // pending | granted | revoked
  sms_consent_at      DateTime?
  sms_opted_out_at    DateTime?
  email_consent_status   String    @default("granted")
  email_unsubscribed_at  DateTime?
}

model CandidateJob {
  candidate_id String
  job_id       String
  is_current   Boolean @default(false)

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@id([candidate_id, job_id])
  @@index([job_id])
}

model Job {
  id                          String @id @default(cuid())
  title                       String
  department                  String
  location                    String
  /// open | closed | on_hold
  status                      String
  job_code                    String @unique
  requisition_id              String?
  hiring_lead_id              String?
  /// JSON array of recruiter user ids (text)
  recruiter_ids               String?
  hiring_workflow_template_id String?

  candidates     CandidateJob[]
  communications Communication[]
  meetings       Meeting[]
}

model Communication {
  id                String  @id @default(cuid())
  candidate_id      String?
  job_id            String?
  /// True when inbound SMS/WhatsApp could not be matched to a candidate (manual assignment later).
  unmatched         Boolean @default(false)
  /// email | sms | whatsapp | meeting | system_notification
  channel           String
  /// outbound | inbound
  direction         String  @default("outbound")
  /// recruiter | hiring_lead | system | candidate | CRM
  sender_type       String
  sender_id         String?
  sender_name       String?
  thread_id         String?
  from_address      String?
  to_address        String?
  /// JSON array of CC emails (text)
  cc_addresses      String?
  subject           String?
  body              String
  template_id       String?
  /// pending | sent | delivered | failed | scheduled | cancelled
  delivery_status   String  @default("pending")
  vendor_message_id String?
  /// Gmail API thread id (send/get); not the application-level thread_id used for UI grouping.
  gmail_thread_id   String?
  sent_at           DateTime @default(now())
  /// When set and delivery_status is scheduled, email is sent at or after this time (see server interval).
  scheduled_for     DateTime?
  read_at           DateTime?

  candidate      Candidate?      @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job            Job?            @relation(fields: [job_id], references: [id], onDelete: Cascade)
  template       EmailTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  meeting_detail Meeting?

  // Add to Communication model fields:
  sms_number_id    String?
  sms_number       SmsNumber? @relation(fields: [sms_number_id], references: [id])
  connected_email_id String?
  connected_email    ConnectedEmail? @relation(fields: [connected_email_id], references: [id], onDelete: SetNull)

  @@index([sms_number_id])
  @@index([connected_email_id])
  @@index([candidate_id, job_id])
  @@index([thread_id])
}

model SmsNumber {
  id               String    @id @default(cuid())
  phone_number     String    
  twilio_phone_sid String?   @unique
  display_label    String?
  number_type      String    @default("dedicated") // dedicated | shared
  assigned_to_id   String?
  assigned_to_name String?
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  // Relation: communications sent from / received on this number
  communications   Communication[]
}

model ConnectedEmail {
  id                String    @id @default(cuid())
  user_id           String    @unique
  user_name         String
  email_address     String
  /// google | microsoft
  provider          String
  access_token      String
  refresh_token     String?
  token_expires_at  DateTime?
  scopes            String?
  is_active         Boolean   @default(true)
  last_sync_at      DateTime?
  sync_cursor       String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  communications Communication[]
}

model Meeting {
  id               String   @id @default(cuid())
  candidate_id     String
  job_id           String
  communication_id String?  @unique
  title            String
  description      String?
  organizer_id     String?
  /// JSON text: [{ "name": "...", "email": "..." }, ...]
  participants     String
  duration_minutes Int
  scheduled_at     DateTime
  /// google_meet | ms_teams | zoom | darwinbox_meet | in_person
  channel          String
  meeting_link     String?
  /// scheduled | rescheduled | completed | cancelled
  status           String

  candidate     Candidate     @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job           Job           @relation(fields: [job_id], references: [id], onDelete: Cascade)
  communication Communication? @relation(fields: [communication_id], references: [id], onDelete: SetNull)
}

model EmailTemplate {
  id               String @id @default(cuid())
  name             String
  /// confirmation | rejection | scheduling | offer | follow_up | assessment_invite | pre_offer | custom
  category         String
  subject_template String
  body_template    String
  /// JSON text: list of variable keys
  variables        String
  /// email | sms | whatsapp
  channel          String @default("email")

  communications Communication[]
}
